# name: test/sql/clickhouse_catalog.test
# description: Test ClickHouse catalog observability and type mappings
# group: [sql]

require clickhouse_scanner

statement ok
ATTACH 'host=localhost port=9000 database=test_db' AS ch (TYPE clickhouse_scanner);

query I
SHOW DATABASES;
----
ch
memory

query I
SELECT table_name
FROM duckdb_tables()
WHERE database_name = 'ch'
ORDER BY table_name;
----
nullable_types
supported_types
t1
vector_size

# Verify every supported ClickHouse type is exposed as the intended DuckDB type.
query III
SELECT column_name, data_type, is_nullable
FROM duckdb_columns()
WHERE database_name = 'ch' AND table_name = 'supported_types'
ORDER BY column_index;
----
bool_value	BOOLEAN	false
uint8_value	UTINYINT	false
int8_value	TINYINT	false
uint16_value	USMALLINT	false
int16_value	SMALLINT	false
uint32_value	UINTEGER	false
int32_value	INTEGER	false
uint64_value	UBIGINT	false
int64_value	BIGINT	false
float32_value	FLOAT	false
float64_value	DOUBLE	false
string_value	VARCHAR	false
fixed_string_value	VARCHAR	false
date_value	DATE	false
datetime_value	TIMESTAMP	false

# Nullable ClickHouse columns must remain nullable in the DuckDB catalog.
query III
SELECT column_name, data_type, is_nullable
FROM duckdb_columns()
WHERE database_name = 'ch' AND table_name = 'nullable_types'
  AND column_name IN ('row_id', 'bool_value', 'uint64_value', 'fixed_string_value', 'datetime_value')
ORDER BY column_index;
----
row_id	UTINYINT	false
bool_value	BOOLEAN	true
uint64_value	UBIGINT	true
fixed_string_value	VARCHAR	true
datetime_value	TIMESTAMP	true

statement ok
USE ch;

query IIIIII
DESCRIBE t1;
----
id	UBIGINT	YES	NULL	NULL	NULL
name	VARCHAR	YES	NULL	NULL	NULL
value	DOUBLE	YES	NULL	NULL	NULL
created_at	TIMESTAMP	YES	NULL	NULL	NULL
