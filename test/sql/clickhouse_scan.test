# name: test/sql/clickhouse_scan.test
# description: Test ClickHouse scan function with projection and filter pushdown
# group: [sql]

require clickhouse_scanner

# Attach ClickHouse database
statement ok
ATTACH 'host=localhost port=9000 database=test_db' AS ch (TYPE clickhouse_scanner);

# Basic scan test - full table scan
query IIII rowsort
SELECT * FROM ch.test_db.t1;
----
1	Alice	99.5	2024-01-01
2	Bob	150.25	2024-01-02
3	Charlie	200.0	2024-01-03

# Projection pushdown test - select specific columns
query II rowsort
SELECT id, name FROM ch.test_db.t1;
----
1	Alice
2	Bob
3	Charlie

# Filter pushdown test - simple comparison
query IIII rowsort
SELECT * FROM ch.test_db.t1 WHERE id > 1;
----
2	Bob	150.25	2024-01-02
3	Charlie	200.0	2024-01-03

# Filter pushdown test - numeric comparison
query II rowsort
SELECT id, name FROM ch.test_db.t1 WHERE value > 100;
----
2	Bob
3	Charlie

# Filter pushdown test - equals
query IIII
SELECT * FROM ch.test_db.t1 WHERE id = 2;
----
2	Bob	150.25	2024-01-02

# Combined projection and filter pushdown
query I rowsort
SELECT name FROM ch.test_db.t1 WHERE id >= 2;
----
Bob
Charlie

# Aggregation test
query I
SELECT COUNT(*) FROM ch.test_db.t1;
----
3

# Aggregation with filter
query I
SELECT COUNT(*) FROM ch.test_db.t1 WHERE value >= 150;
----
2

# SUM aggregation
query I
SELECT SUM(value) FROM ch.test_db.t1;
----
449.75

# Test with ORDER BY
query II
SELECT id, name FROM ch.test_db.t1 ORDER BY id DESC;
----
3	Charlie
2	Bob
1	Alice

# Test IN filter (if supported by filter pushdown)
query II rowsort
SELECT id, name FROM ch.test_db.t1 WHERE id IN (1, 3);
----
1	Alice
3	Charlie

# Test date filter
query II rowsort
SELECT id, name FROM ch.test_db.t1 WHERE created_at >= '2024-01-02';
----
2	Bob
3	Charlie

# Test complex filter with AND
query II
SELECT id, name FROM ch.test_db.t1 WHERE id > 1 AND value < 200;
----
2	Bob

# Test complex filter with OR
query I rowsort
SELECT id FROM ch.test_db.t1 WHERE id = 1 OR value > 190;
----
1
3

# Test JOIN (to verify scan works in complex queries)
query III
SELECT t1.id, t1.name, t1.value 
FROM ch.test_db.t1 t1 
WHERE t1.id = 2;
----
2	Bob	150.25

# Test LIMIT
query I
SELECT name FROM ch.test_db.t1 ORDER BY id LIMIT 1;
----
Alice

# Test IS NULL filter (if table has nulls - optional)
query I
SELECT COUNT(*) FROM ch.test_db.t1 WHERE name IS NOT NULL;
----
3
