# name: test/sql/clickhouse_scan.test
# description: Test ClickHouse scans, supported types, and pushdown
# group: [sql]

require clickhouse_scanner

statement ok
ATTACH 'host=localhost port=9000 database=test_db' AS ch (TYPE clickhouse_scanner);

# Basic scan test - full table scan
query IIII rowsort
SELECT * FROM ch.t1;
----
1	Alice	99.5	2024-01-01 00:00:00
2	Bob	150.25	2024-01-02 00:00:00
3	Charlie	200.0	2024-01-03 00:00:00

# Projection pushdown test - select specific columns
query II rowsort
SELECT id, name FROM ch.t1;
----
1	Alice
2	Bob
3	Charlie

# Filter pushdown test - simple comparison
query IIII rowsort
SELECT * FROM ch.t1 WHERE id > 1;
----
2	Bob	150.25	2024-01-02 00:00:00
3	Charlie	200.0	2024-01-03 00:00:00

# Filter pushdown test - numeric comparison
query II rowsort
SELECT id, name FROM ch.t1 WHERE value > 100;
----
2	Bob
3	Charlie

# Filter pushdown test - equals
query IIII
SELECT * FROM ch.t1 WHERE id = 2;
----
2	Bob	150.25	2024-01-02 00:00:00

# Combined projection and filter pushdown
query I rowsort
SELECT name FROM ch.t1 WHERE id >= 2;
----
Bob
Charlie

# Aggregations over a ClickHouse scan
query III
SELECT COUNT(*), SUM(value), COUNT(*) FILTER (WHERE value >= 150) FROM ch.t1;
----
3	449.75	2

# Test with ORDER BY
query II
SELECT id, name FROM ch.t1 ORDER BY id DESC;
----
3	Charlie
2	Bob
1	Alice

# Test IN filter
query II rowsort
SELECT id, name FROM ch.t1 WHERE id IN (1, 3);
----
1	Alice
3	Charlie

# Test timestamp filter
query II rowsort
SELECT id, name FROM ch.t1 WHERE created_at >= TIMESTAMP '2024-01-02 00:00:00';
----
2	Bob
3	Charlie

# Test complex filters
query II
SELECT id, name FROM ch.t1 WHERE id > 1 AND value < 200;
----
2	Bob

query I rowsort
SELECT id FROM ch.t1 WHERE id = 1 OR value > 190;
----
1
3

# Test a scan in a join
query III
SELECT t1.id, t1.name, t1.value
FROM ch.t1 t1
WHERE t1.id = 2;
----
2	Bob	150.25

# Test LIMIT
query I
SELECT name FROM ch.t1 ORDER BY id LIMIT 1;
----
Alice

# Test IS NOT NULL filter
query I
SELECT COUNT(*) FROM ch.t1 WHERE name IS NOT NULL;
----
3

# All non-null ClickHouse types currently supported by the scanner
query IIIIIIIII
SELECT bool_value, uint8_value, int8_value, uint16_value, int16_value,
       uint32_value, int32_value, uint64_value, int64_value
FROM ch.supported_types;
----
true	255	-128	65535	-32768	4294967295	-2147483648	18446744073709551615	-9223372036854775808

query IIIIII
SELECT float32_value, float64_value, string_value, fixed_string_value, date_value, datetime_value
FROM ch.supported_types;
----
1.5	-2.25	clickhouse	fixed	2024-02-29	2024-02-29 12:34:56

# Nullable wrappers for every supported ClickHouse type
query IIIIIIIIIIIIIIII
SELECT * FROM ch.nullable_types ORDER BY row_id;
----
1	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
2	false	42	-42	4242	-4242	424242	-424242	42424242	-42424242	3.5	-4.5	nullable	value	2023-12-31	2023-12-31 23:59:58

query II
SELECT COUNT(*) FILTER (WHERE string_value IS NULL),
       COUNT(*) FILTER (WHERE datetime_value IS NOT NULL)
FROM ch.nullable_types;
----
1	1

# The source block has STANDARD_VECTOR_SIZE * 2 + 1 rows. These aggregates
# detect skipped, duplicated, or corrupted values at DuckDB vector boundaries.
query IIIIII
SELECT COUNT(*), COUNT(DISTINCT id), SUM(id), SUM(value), MIN(id), MAX(id)
FROM ch.vector_size;
----
4097	4097	8390656	0	0	4096

query III
SELECT id, label, nullable_id
FROM ch.vector_size
ORDER BY id
LIMIT 3 OFFSET 2047;
----
2047	row-2047	2047
2048	row-2048	NULL
2049	row-2049	2049

query II
SELECT COUNT(*) FILTER (WHERE nullable_id IS NULL), SUM(length(label))
FROM ch.vector_size;
----
2049	31666

# LowCardinality strings remain correct through dictionary-vector execution.
query IIII
SELECT COUNT(*), COUNT(DISTINCT category),
       COUNT(*) FILTER (WHERE nullable_category IS NULL),
       COUNT(DISTINCT nullable_category)
FROM ch.low_cardinality_types;
----
4097	301	820	17

query III
SELECT row_id, category, nullable_category
FROM ch.low_cardinality_types
ORDER BY row_id
LIMIT 3 OFFSET 2047;
----
2047	category-241	nullable-7
2048	category-242	nullable-8
2049	category-243	nullable-9

query I
SELECT COUNT(*)
FROM ch.low_cardinality_types
WHERE category = '';
----
13

query II rowsort
SELECT nullable_category, COUNT(*)
FROM ch.low_cardinality_types
WHERE nullable_category IS NOT NULL
GROUP BY nullable_category;
----
nullable-0	192
nullable-1	193
nullable-10	192
nullable-11	193
nullable-12	193
nullable-13	193
nullable-14	193
nullable-15	192
nullable-16	193
nullable-2	193
nullable-3	193
nullable-4	193
nullable-5	192
nullable-6	193
nullable-7	193
nullable-8	193
nullable-9	193
